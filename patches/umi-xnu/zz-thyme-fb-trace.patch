	ldr x9, [x25, #16]
	cbnz x9, Lbootstrap_tables_exhausted
	mov x0, #0x17c00000
	mov x4, x0
	mov x5, #1
	mov x1, x25
	create_bootstrap_mapping x0, x4, x5, x1, x2, x6, x10, x11, x12, x13
	add x9, x2, #0xe00
	MOV64 x10, (0x17c00000 | ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
	str x10, [x9]
