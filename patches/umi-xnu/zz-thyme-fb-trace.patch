diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -1,3 +1,9 @@
 		add x9, x2, #0xc00
 		MOV64 x10, (0xb0000000 | ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 		str x10, [x9]
+		// thyme: map the inherited splash framebuffer (2 MiB, uncached)
+		// so THYME_BAND can paint stage bands after the MMU comes up.
+		// Same L2 table as the console block (both live in L1 slot 2).
+		add x9, x2, #0x700
+		MOV64 x10, (0x9c000000 | ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+		str x10, [x9]
 		UMI_TRACE 0x03, x2
 #endif
